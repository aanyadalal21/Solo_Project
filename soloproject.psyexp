  <Flow>
    <Routine name="instructions"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('Scenario_text', 'Genetic testing before pregnancy shows a 75% chance that your child will be born completely healthy and free of a specific inherited disorder. On a scale of 1-7, how likely are you to proceed with conception?'), ('Condition', 'Positive'), ('Frame', 'Carrier Screening')]), OrderedDict([('Scenario_text', 'Genetic testing before pregnancy shows a 25% chance that your child will inherit a specific genetic disorder. On a scale of 1-7, how likely are you to proceed with conception?'), ('Condition', 'Negative'), ('Frame', 'Carrier Screening')]), OrderedDict([('Scenario_text', 'A routine prenatal test accurately confirms healthy chromosomes in 98% of pregnancies. On a scale of 1-7, how likely are you to opt for this test?'), ('Condition', 'Positive'), ('Frame', 'Prenatal Test')]), OrderedDict([('Scenario_text', 'A routine prenatal test yields unclear or abnormal chromosome results in 2% of pregnancies. On a scale of 1-7, how likely are you to opt for this test?'), ('Condition', 'Negative'), ('Frame', 'Prenatal Test')]), OrderedDict([('Scenario_text', 'A new experimental lung cancer drug successfully stops tumor growth in 60% of patients. On a scale of 1-7, how confident are you in this therapy?'), ('Condition', 'Positive'), ('Frame', 'Lung Cancer Drug')]), OrderedDict([('Scenario_text', 'A new experimental lung cancer drug fails to stop tumor growth in 40% of patients. On a scale of 1-7, how confident are you in this therapy?'), ('Condition', 'Negative'), ('Frame', 'Lung Cancer Drug')]), OrderedDict([('Scenario_text', 'A new probiotic treatment for severe bowel inflammation successfully protects the stomach lining in 80% of patients. On a scale of 1-7, how likely are you to recommend this intervention?'), ('Condition', 'Positive'), ('Frame', 'Bowel Treatment')]), OrderedDict([('Scenario_text', 'A new probiotic treatment for severe bowel inflammation causes damage to the stomach lining in 20% of patients. On a scale of 1-7, how likely are you to recommend this intervention?'), ('Condition', 'Negative'), ('Frame', 'Bowel Treatment')]), OrderedDict([('Scenario_text', 'Advanced genetic testing for childhood developmental delays provides a clear medical diagnosis in 40% of cases. On a scale of 1-7, how likely are you to authorize this testing?'), ('Condition', 'Positive'), ('Frame', 'Childhood Genetics')]), OrderedDict([('Scenario_text', 'Advanced genetic testing for childhood developmental delays leaves 60% of cases without a clear medical diagnosis. On a scale of 1-7, how likely are you to authorize this testing?'), ('Condition', 'Negative'), ('Frame', 'Childhood Genetics')]), OrderedDict([('Scenario_text', 'People who inherit this specific gene mutation have a 20% chance of staying completely healthy throughout their lives. On a scale of 1-7, how likely are you to get tested for this gene?'), ('Condition', 'Positive'), ('Frame', 'Gene Mutation')]), OrderedDict([('Scenario_text', 'People who inherit this specific gene mutation have an 80% chance of developing illness during their lives. On a scale of 1-7, how likely are you to get tested for this gene?'), ('Condition', 'Negative'), ('Frame', 'Gene Mutation')]), OrderedDict([('Scenario_text', 'The standard chemotherapy for colon cancer provides a 70% chance of being completely cancer-free after five years. On a scale of 1-7, how likely are you to consent to this treatment?'), ('Condition', 'Positive'), ('Frame', 'Chemotherapy')]), OrderedDict([('Scenario_text', 'The standard chemotherapy for colon cancer carries a 30% chance of the cancer returning within five years. On a scale of 1-7, how likely are you to consent to this treatment?'), ('Condition', 'Negative'), ('Frame', 'Chemotherapy')]), OrderedDict([('Scenario_text', 'A specific medical diet designed to improve gut health successfully reduces severe depression symptoms in 65% of patients. On a scale of 1-7, how likely are you to adopt this diet?'), ('